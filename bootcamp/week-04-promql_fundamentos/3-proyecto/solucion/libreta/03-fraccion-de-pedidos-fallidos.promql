# ¿Qué fracción de los pedidos falla?
# Devuelve: un valor sin labels entre 0 y 1, con una ventana de 5m.

  sum(rate(http_server_request_duration_seconds_count{job="pedidos", method="POST", route="/orders", status_code!="201"}[5m]))
/
  sum(rate(http_server_request_duration_seconds_count{job="pedidos", method="POST", route="/orders"}[5m]))
